# =========================================================================
# BUJJI AI - PERSONAL VOICE ASSISTANT ENVIRONMENT CONFIGURATION
# =========================================================================
# Copy this file to .env and configure your preferences:
# cp .env.example .env

# Your Name (How Bujji will address you)
USER_NAME=Kowshik

# Inactivity Timeout (Seconds before auto-dropping to low-power standby)
# 300 = 5 minutes | 600 = 10 minutes
BUJJI_INACTIVITY_TIMEOUT=300

# =========================================================================
# LLM Intelligence Providers (Configure any ONE or more)
# =========================================================================

# 1. FreeLLMAPI Unified Gateway (Default local endpoint)
FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=auto

# 2. Google Gemini API (Recommended: fast, high context, free tier available)
GEMINI_API_KEY=

# 3. Groq Cloud API (Super fast inference with Llama 3.3 70B)
GROQ_API_KEY=

# 4. OpenAI API (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# =========================================================================
# Neural Voice Customization (Microsoft Edge Neural Voices - Free!)
# =========================================================================
# Popular Voices:
# - 'en-IN-NeerjaNeural' (Indian English Female - lively, friendly Bujji style)
# - 'en-IN-PrabhatNeural' (Indian English Male)
# - 'en-GB-RyanNeural' (British English Male - Jarvis Mark-LVII style)
# - 'en-US-AriaNeural' (US English Female - Siri/Alexa style)
BUJJI_VOICE=en-IN-NeerjaNeural
BUJJI_SPEED=+5%
BUJJI_PITCH=+0Hz

# Projects Directory (Where code / software tasks are created)
BUJJI_PROJECTS_DIR=~/BujjiProjects
